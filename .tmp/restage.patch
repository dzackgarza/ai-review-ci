commit dfbca4c54559b61deba7327a66e3c668140142f3
Author: D. Zack Garza <dzackgarza@gmail.com>
Date:   Wed Oct 21 13:38:20 2026 +0000

    fix(normalize): stage what the commit-tier formatters rewrite
    
    flowmark, prettier and ruff rewrite the working tree, but the commit
    records the index, so every normalized commit kept its unformatted text
    and left the formatting behind as an unstaged change: whole-file
    reformats of research's TRAPS.md and COMPLAINTS.md, and ruff's reflow of
    each Python commit in lattice-database.
    
    A staged file whose working tree equals its staged blob is restaged after
    its formatter runs. A partially staged file is not, since restaging it
    would commit its unstaged hunks; it is named in a warning instead.
    
    Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/justfiles/python.just b/justfiles/python.just
index 0d82b63..cc023f4 100644
--- a/justfiles/python.just
+++ b/justfiles/python.just
@@ -370,6 +370,20 @@ _normalize: _install-tools
 		echo "ruff normalization: no changed Python files."
 		exit 0
 	fi
+	# ruff rewrites the working tree, so a fix reaches the commit only when it is
+	# staged again: a staged file whose working tree equals its staged blob is
+	# restaged after ruff; a partially staged one is named instead.
+	restage=()
+	partial=()
+	for file in "${python_files[@]}"; do
+		if git diff --cached --quiet -- "$file"; then
+			continue
+		elif git diff --quiet -- "$file"; then
+			restage+=("$file")
+		else
+			partial+=("$file")
+		fi
+	done
 	if uvx --from ruff ruff check --fix \
 		--config {{configs}}/ruff-global.toml \
 		"${python_files[@]}"; then
@@ -390,6 +404,13 @@ _normalize: _install-tools
 		"{{artifacts}}/scripts/emit-triage-directive.sh"
 		exit $ec
 	fi
+	if [ "${#restage[@]}" -gt 0 ]; then
+		git add -- "${restage[@]}"
+	fi
+	if [ "${#partial[@]}" -gt 0 ]; then
+		echo "WARNING: ruff fixes not staged, since these files have unstaged changes:" >&2
+		printf '  %s\n' "${partial[@]}" >&2
+	fi
 
 _pytest: _install-tools
 	#!/usr/bin/env bash
diff --git a/justfiles/shared.just b/justfiles/shared.just
index d856edf..7529911 100644
--- a/justfiles/shared.just
+++ b/justfiles/shared.just
@@ -67,6 +67,21 @@ _format-structured-text:
 			*.json|*.jsonc|*.yaml|*.yml) data_files+=("$file") ;;
 		esac
 	done < <(git diff --cached --name-only --diff-filter=ACMR -z -- . "${exclude_pathspecs[@]}")
+	# The formatter rewrites the working tree, so its output reaches the commit only
+	# when it is staged again. A file whose working tree equals its staged blob is
+	# restaged; a partially staged file is not, since that would stage its unstaged
+	# hunks, and it is named so its formatted working tree is not mistaken for new work.
+	commit_index="${GIT_INDEX_FILE:-}"
+	restage=()
+	partial=()
+	for file in "${md_files[@]}" "${data_files[@]}"; do
+		if git diff --quiet -- "$file"; then
+			restage+=("$file")
+		else
+			partial+=("$file")
+		fi
+	done
+	repository_root="$(git rev-parse --show-toplevel)"
 	# git-sourced uvx tools must not inherit repository-location variables: they
 	# can otherwise redirect their own fetch at the host repository and fail.
 	# The selected file lists above already preserve the temporary commit index.
@@ -86,6 +101,14 @@ _format-structured-text:
 		printf '%s\0' "${data_files[@]}" | xargs -0 \
 			npx -y prettier --write --config {{configs}}/prettier-global.json
 	fi
+	if [ "${#restage[@]}" -gt 0 ]; then
+		printf '%s\0' "${restage[@]}" | GIT_INDEX_FILE="${commit_index:-$(git -C "$repository_root" rev-parse --git-path index)}" \
+			xargs -0 git -C "$repository_root" add --
+	fi
+	if [ "${#partial[@]}" -gt 0 ]; then
+		echo "WARNING: formatted but not staged, since these files have unstaged changes:" >&2
+		printf '  %s\n' "${partial[@]}" >&2
+	fi
 
