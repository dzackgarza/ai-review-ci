{
  "typeCheckingMode": "strict",
  "pythonVersion": "3.14",
  "pythonPlatform": "Linux",
  "exclude": [
    "**/tests/fixtures",
    "**/node_modules",
    "**/.venv",
    "**/.pytest_cache",
    "**/.import_linter_cache",
    "**/__pycache__",
    "**/dist",
    "**/build",
    "**/coverage",
    "**/_ci-support",
    "**/devtools",
    "**/codeql-db",
    "**/tool-artifacts/models",
    "**/@girs",
    "**/__stubs__",
    "**/external",
    "**/target",
    "**/*.bak",
    "**/.git",
    "**/.next",
    "**/.lake",
    "**/.worktrees",
    "**/.claude/worktrees",
    "**/.agents",
    "**/.hermes",
    "**/vendor",
    "**/third_party",
    "**/venv",
    "**/archives",
    "**/src.bak",
    "**/scripts",
    "**/notebooks",
    "**/preamble",
    "**/notes",
    "**/.webpack",
    "**/out",
    "**/release"
  ]
}
