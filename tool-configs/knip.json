{
  "entry": [
    "src/index.ts",
    "src/**/*.ts",
    "app.tsx",
    "lib/**/*.ts",
    "src/**/*.css",
    "app.css",
    "index.css",
    "src/**/*.tsx",
    "source/**/*.{js,ts,tsx,vue}",
    "test/**/*.{js,ts,tsx}",
    "e2e/**/*.spec.{js,ts,tsx}",
    "scripts/**/*.{js,cjs,mjs,ts,tsx}",
    "forge.config.{js,cjs,mjs,ts}",
    "webpack*.{js,cjs,mjs,ts}",
    "extension/**/*.{js,ts,tsx}",
    "extension/**/*.css",
    "tests/**/*.test.{js,ts,tsx}",
    "tests/**/*.spec.{js,ts,tsx}",
    "tests/**/__tests__/**/*.{js,ts,tsx}"
  ],
  "project": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "source/**/*.{js,ts,tsx,vue}",
    "test/**/*.{js,ts,tsx}",
    "e2e/**/*.{js,ts,tsx}",
    "scripts/**/*.{js,cjs,mjs,ts,tsx}",
    "forge.config.{js,cjs,mjs,ts}",
    "webpack*.{js,cjs,mjs,ts}",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "widget/**/*.tsx",
    "services/**/*.ts",
    "app.tsx",
    "src/**/*.css",
    "app.css",
    "index.css",
    "extension/**/*.{js,ts,tsx}",
    "extension/**/*.css",
    "tests/**/*.{js,ts,tsx}"
  ],
  "ignore": [
    "**/env.d.ts",
    "**/tests/fixtures/**",
    "**/test/highlight/**",
    "**/test/tags/**",
    "**/examples/**",
    "**/bindings/**",
    "**/node_modules/**",
    "**/.venv/**",
    "**/.pytest_cache/**",
    "**/.import_linter_cache/**",
    "**/__pycache__/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/_ci-support/**",
    "**/devtools/**",
    "**/codeql-db/**",
    "**/tool-artifacts/models/**",
    "**/@girs/**",
    "**/__stubs__/**",
    "**/external/**",
    "**/target/**",
    "**/*.bak/**",
    "**/.git/**",
    "**/.next/**",
    "**/.lake/**",
    "**/.worktrees/**",
    "**/.claude/worktrees/**",
    "**/.agents/**",
    "**/.hermes/**",
    "**/vendor/**",
    "**/third_party/**",
    "**/venv/**",
    "**/archives/**",
    "**/src.bak/**",
    "**/notebooks/**",
    "**/notes/**",
    "**/.webpack/**",
    "**/out/**",
    "**/release/**"
  ],
  "ignoreDependencies": [
    "gi",
    "@girs",
    "@logtape/logtape",
    "@ags/shared",
    "ags",
    "@tailwindcss/cli",
    "@tailwindcss/typography",
    "tailwindcss",
    "tw-animate-css",
    "@electron-forge/maker-deb",
    "@electron-forge/maker-rpm",
    "@electron-forge/maker-zip",
    "@electron-forge/plugin-webpack",
    "@vercel/webpack-asset-relocator-loader",
    "css-loader",
    "less-loader",
    "node-loader",
    "style-loader",
    "ts-loader",
    "tsx",
    "unist"
  ],
  "ignoreBinaries": [
    "ags",
    "xdg-open",
    "direnv",
    "gsettings",
    "pandoc",
    "pgrep",
    "just"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreUnresolved": [
    "./vendor/backend.js",
    "./vendor/pdfjs/pdf_viewer.mjs"
  ]
}
