{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "**",
      "!tsconfig.json",
      "!**/tsconfig.json",
      "!biome.json",
      "!**/*.md",
      "!**/*.markdown",
      "!**/*.qmd",
      "!**/*.yaml",
      "!**/*.yml",
      "!**/tests/fixtures/**",
      "!**/test/fixtures/**",
      "!**/test/highlight/**",
      "!**/test/tags/**",
      "!**/examples/**",
      "!**/bindings/**",
      "!**/generated/**",
      "!**/node_modules/**",
      "!**/.yarn/**",
      "!**/labextension/**",
      "!**/.venv/**",
      "!**/.pytest_cache/**",
      "!**/.import_linter_cache/**",
      "!**/__pycache__/**",
      "!**/dist/**",
      "!**/build/**",
      "!**/coverage/**",
      "!**/.nyc_output/**",
      "!**/_ci-support/**",
      "!**/devtools/**",
      "!**/codeql-db/**",
      "!**/tool-artifacts/models/**",
      "!**/@girs/**",
      "!**/__stubs__/**",
      "!**/external/**",
      "!**/target/**",
      "!**/*.bak/**",
      "!**/.git/**",
      "!**/.next/**",
      "!**/.lake/**",
      "!**/.worktrees/**",
      "!**/.claude/worktrees/**",
      "!**/.agents/**",
      "!**/.hermes/**",
      "!**/vendor/**",
      "!**/third_party/**",
      "!**/venv/**",
      "!**/archives/**",
      "!**/src.bak/**",
      "!**/scripts/**",
      "!**/notebooks/**",
      "!**/computations/reports/**",
      "!**/preamble/**",
      "!**/notes/**",
      "!**/.webpack/**",
      "!**/out/**",
      "!**/release/**"
    ]
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": false
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
