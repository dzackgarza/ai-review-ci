# List available recipes.
default:
    @just --list

# Run commit-tier Yarn/TypeScript QC through the central implementation.
test-commit:
    @just -f ~/ai-review-ci/justfiles/yarn.just -d . test-commit

# Run the full project-owned Yarn test suite before pushing.
test-push:
    @just -f ~/ai-review-ci/justfiles/yarn.just -d . test-push

# Run CI acceptance QC through the central implementation.
test-ci:
    @just -f ~/ai-review-ci/justfiles/yarn.just -d . test-ci
