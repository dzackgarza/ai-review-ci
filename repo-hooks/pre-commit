#!/usr/bin/env sh
. "$(dirname -- "$(readlink -f "$0")")/hook-timing.sh"
set -e
. "$(dirname -- "$(readlink -f "$0")")/qc-exempt.sh"
qc_should_gate || exit 0

# The commit hook runs exactly the repository's `just test-commit`.
if just test-commit; then
    qc_print_directive pre-commit
    exit 0
fi
echo "ai-review-ci commit gate failed: just test-commit; see the output above." >&2
exit 1
