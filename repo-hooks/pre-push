#!/usr/bin/env sh
set -e
. "$(dirname -- "$(readlink -f "$0")")/qc-exempt.sh"
qc_should_gate || exit 0

# GitHub CI owns all suites and review diagnostics. In particular, no
# API-dependent issue-closure confrontation or machine-wide heavy gate runs
# during publication of an unfinished implementation.
if python3 "$qc_hook_repo/scripts/local-check.py" --mode push --pre-push --remote "${1:-origin}"; then
    exit 0
fi
echo "Local outgoing-commit syntax check failed; see the file and line above." >&2
exit 1
