#!/usr/bin/env sh
set -e
. "$(dirname -- "$(readlink -f "$0")")/qc-exempt.sh"

if ! qc_should_gate; then
	exit 0
fi

# Closure-claim confrontation (#244): a default-branch push whose commit
# messages carry GitHub closing keywords closes those issues server-side.
# Reads the same keyword input GitHub acts on, then blocks once with the
# issues' verbatim asks. Consumes this hook's stdin (the ref lines).
python3 "$qc_hook_repo/global-hooks/confront_closes.py" "$1" || exit 1

if just test-push; then
	exit 0
fi

cat >&2 <<'MSG'

────────────────────────────────────────────────────────────────
ai-review-ci push gate FAILED (just test-push).

If the gate is red by design — a red proof landed before its fix, or an
acceptance suite written up front that stays red until its work units land —
use the sanctioned, auditable route instead of `git push --no-verify`:

    ai-review-ci red-push --issue <owning-issue>

It runs the same gate, refuses if the gate passes, notes `Red-Push: #<issue>`
on the pushed commit (refs/notes/red-push), and bypasses the gate for that one
push only. Wiki repositories, repositories not under the dzackgarza account, and
forks of third-party projects are auto-detected and skipped above.

Any other failure is direct project/test repair work. Fix the reported object
and push again; do not start a PR disposition or subagent remediation workflow.
────────────────────────────────────────────────────────────────
MSG
exit 1
