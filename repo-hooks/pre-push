#!/usr/bin/env sh
. "$(dirname -- "$(readlink -f "$0")")/hook-timing.sh"
set -e
. "$(dirname -- "$(readlink -f "$0")")/qc-exempt.sh"
. "$(dirname -- "$(readlink -f "$0")")/lfs-hooks.sh"

run_qc() {
    if qc_should_gate; then
        if AI_REVIEW_CI_PRE_PUSH_REMOTE="${1:-origin}" just test-push; then
            qc_print_directive pre-push
        else
            echo "ai-review-ci push gate failed: just test-push; see the output above." >&2
            return 1
        fi
    fi
}

if lfs_hooks_enabled; then
    (
        refs=$(mktemp)
        trap 'rm -f -- "$refs"' EXIT
        cat > "$refs"
        run_qc "$@" < "$refs"
        git lfs pre-push "$@" < "$refs"
    )
else
    run_qc "$@"
fi
