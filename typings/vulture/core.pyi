import ast
from collections.abc import Iterable
from pathlib import Path

class Vulture:
    filename: Path
    def __init__(self, verbose: bool = ..., ignore_names: Iterable[str] | None = ..., ignore_decorators: Iterable[str] | None = ...) -> None: ...
    def visit(self, node: ast.AST) -> None: ...
    def visit_arg(self, node: ast.arg) -> None: ...
    def visit_ClassDef(self, node: ast.ClassDef) -> None: ...
    def visit_FunctionDef(self, node: ast.FunctionDef) -> None: ...
    def scavenge(self, paths: Iterable[str], exclude: Iterable[str] | None = ...) -> None: ...
    def report(self, min_confidence: int = ..., sort_by_size: bool = ..., make_whitelist: bool = ...) -> int: ...
