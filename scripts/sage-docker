#!/usr/bin/env bash
set -euo pipefail

image=ghcr.io/dzackgarza/sage:develop
container=sage-research
sage=/sage/.venv/bin/sage

# A group change takes effect in new logins. Keep existing shells usable too.
docker_gid=$(getent group docker | cut -d: -f3)
if ! id -G | tr ' ' '\n' | grep -qx "$docker_gid"; then
    launcher_dir=$(dirname -- "$(readlink -f -- "$0")")
    exec bash "$launcher_dir/group-exec" docker env PATH="/snap/bin:$PATH" "$0" "$@"
fi

mode=${0##*/}
if [[ "$mode" == sage-docker-update ]]; then
    exec 9>/home/dzack/.cache/sage-docker-tmp/update.lock
    flock 9
    # The image owns the whole environment, so a container built from an older
    # image is replaced rather than kept.
    docker pull "$image"
    current=$(docker inspect --format '{{.Image}}' "$container" 2>/dev/null || true)
    if [[ -n "$current" && "$current" != $(docker inspect --format '{{.Id}}' "$image") ]]; then
        docker rm -f "$container"
        current=
    fi
    if [[ -z "$current" ]]; then
        # Sage runs in the caller's working directory, so every repository must be visible.
        docker run -d --restart unless-stopped --name "$container" --entrypoint /bin/sleep \
            --mount type=bind,src=/home/dzack,dst=/home/dzack \
            "$image" infinity
    elif [[ $(docker inspect --format '{{.State.Running}}' "$container") == false ]]; then
        docker start "$container"
    fi
    for ((attempt = 0; attempt < 120; attempt++)); do
        if docker top "$container" 2>/dev/null | grep -q 'sleep infinity'; then
            break
        fi
        if [[ $(docker inspect --format '{{.State.Running}}' "$container") != true ]]; then
            docker logs "$container"
            exit 1
        fi
        sleep 1
    done
    docker top "$container" | grep -q 'sleep infinity'
    docker exec "$container" mkdir -p /tmp/sage-home-dzack
    docker exec "$container" chown "$(id -u):$(id -g)" /tmp/sage-home-dzack
    # The image carries locked copies of the Sage research projects; the desk
    # replaces them with editable installs of its checkouts, so the container
    # always runs their working trees. research, which the image does not
    # carry, comes first: it pulls the others from git, and their checkouts
    # then replace those copies.
    docker exec "$container" chown -R "$(id -u):$(id -g)" /sage/.venv
    as_user=(docker exec -u "$(id -u):$(id -g)" -e HOME=/tmp/sage-home-dzack "$container")
    venv_python=/sage/.venv/bin/python
    "${as_user[@]}" uv pip install --python "$venv_python" -e /home/dzack/research
    for checkout in sage-extensions sage-julia-bridge tree-sitter-sage; do
        "${as_user[@]}" uv pip install --python "$venv_python" --no-deps -e "/home/dzack/gitclones/$checkout"
    done
    # sage-categories declares its native workspace member only in its
    # `platform` group, which its own CI installs with the project.
    "${as_user[@]}" uv pip install --python "$venv_python" --project /home/dzack/gitclones/sage-categories \
        --group platform --editable /home/dzack/gitclones/sage-categories
    "${as_user[@]}" uv pip check --python "$venv_python"
    docker exec -u "$(id -u):$(id -g)" -e HOME=/tmp/sage-home-dzack \
        -e PYTHONNOUSERSITE=1 "$container" "$sage" -c 'print(1)'
    exit
fi

if [[ $(docker inspect --format '{{.State.Running}}' "$container" 2>/dev/null || true) != true ]]; then
    printf 'Sage container is not running; run sage-docker-update first.\n' >&2
    exit 1
fi

# Julia packages resolved at runtime go to a writable depot in front of the
# image's read-only Oscar depot; the trailing empty entry keeps the stdlib depot.
env_args=(-e HOME=/tmp/sage-home-dzack -e PYTHONNOUSERSITE=1
    -e JULIA_DEPOT_PATH=/tmp/sage-home-dzack/.julia:/opt/julia-depot:)
for name in PYTHONPATH MYPYPATH TMPDIR SAGE_STARTUP_FILE SAGE_CATEGORIES_GAP_PACKAGE_DIR RESEARCH_EXPERIMENTS RESEARCH_ARCHIVES RESEARCH_SOURCE; do
    if [[ -v $name ]]; then
        env_args+=(-e "$name")
    fi
done

case "$mode" in
    sage|sage-docker)
        command=("$sage" "$@")
        ;;
    sage-docker-preparse)
        command=("$sage" -preparse "$@")
        ;;
    sage-docker-python)
        if [[ ${1:-} == */sage-docker-preparse ]]; then
            shift
            command=("$sage" -preparse "$@")
        elif [[ ${1:-} == */sage-preparse ]]; then
            shift
            command=("$sage" -preparse "$@")
        else
            command=("$sage" -python "$@")
        fi
        ;;
    *)
        printf 'Unknown Sage Docker launcher: %s\n' "$mode" >&2
        exit 2
        ;;
esac

exec docker exec -i -u "$(id -u):$(id -g)" -w "$PWD" "${env_args[@]}" \
    "$container" "${command[@]}"
