#!/usr/bin/env bash
set -euo pipefail

image=ghcr.io/dzackgarza/sage:develop
container=sage-research
sage_bin=/sage/.venv/bin
container_path="$sage_bin:/opt/elan/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
julia_depot=/root/.julia:/opt/julia-depot:

export DOCKER_HOST="unix:///run/user/$(id -u)/docker.sock"
docker() { "$HOME/bin/docker" "$@"; }

volumes=(sage-tree:/sage sage-repos:/repos sage-julia:/root/.julia)
volume_root="$HOME/.local/share/docker/volumes"
checkout_root="$HOME/gitclones"

mode=${0##*/}
if [[ "$mode" == sage-docker-update ]]; then
    mkdir -p "$HOME/.cache/sage-docker-tmp"
    exec 9>"$HOME/.cache/sage-docker-tmp/update.lock"
    flock 9
    repository=${image%:*}
    registry=${repository%%/*}
    token=$(curl -fsS "https://$registry/token?scope=repository:${repository#*/}:pull" | jq -er .token)
    remote_digest=$(curl -fsSI -H "Authorization: Bearer $token" \
        -H 'Accept: application/vnd.oci.image.index.v1+json' \
        -H 'Accept: application/vnd.docker.distribution.manifest.list.v2+json' \
        "https://$registry/v2/${repository#*/}/manifests/${image##*:}" \
        | awk -F': ' 'tolower($1) == "docker-content-digest" { sub(/\r$/, "", $2); print $2 }')
    [[ -n "$remote_digest" ]]
    container_id=$(docker ps --all --quiet --filter "name=^/${container}$")
    current=
    if [[ -n "$container_id" ]]; then
        current=$(docker inspect --format '{{.Image}}' "$container_id")
    fi
    local_image="$current"
    if [[ -z "$local_image" ]]; then
        local_image=$(docker image ls --no-trunc --filter "reference=$image" --format '{{.ID}}')
    fi
    if [[ -n "$local_image" ]]; then
        local_digests=$(docker image inspect --format '{{join .RepoDigests "\n"}}' "$local_image")
        if ! grep -qxF "$repository@$remote_digest" <<< "$local_digests"; then
            revision=$(docker image inspect "$local_image" | jq -er \
                '.[0].Config.Labels["org.opencontainers.image.revision"]')
            if [[ -n "$current" ]]; then
                docker rm -f "$container"
            fi
            docker image rm "$local_image"
            docker image prune --force --filter "label=org.opencontainers.image.revision=$revision"
            current=
        fi
    fi
    docker pull "$image"
    tree="$volume_root/sage-tree/_data"
    image_revision=$(docker image inspect "$image" | jq -er \
        '.[0].Config.Labels["org.opencontainers.image.revision"]')
    if [[ -d "$tree/.git" && "$(cat "$volume_root/sage-tree/image-revision" 2>/dev/null)" != "$image_revision" ]]; then
        if [[ -n "$(git -C "$tree" status --porcelain)" ]]; then
            printf 'the sage-tree checkout %s has uncommitted changes; commit them before updating to %s\n' \
                "$tree" "$image_revision" >&2
            exit 1
        fi
        git -C "$tree" fetch --quiet origin "$image_revision"
        git -C "$tree" merge --quiet --ff-only "$image_revision"
        if [[ -n "$current" ]]; then
            docker rm -f "$container"
            current=
        fi
        staging=$(mktemp -d "$volume_root/sage-tree/image-products.XXXXXX")
        source_container=$(docker create "$image")
        for product in .venv builddir; do
            docker cp "$source_container:/sage/$product" "$staging/$product"
        done
        docker rm "$source_container"
        for product in .venv builddir; do
            trash "$tree/$product"
            mv "$staging/$product" "$tree/$product"
        done
        rmdir "$staging"
        printf '%s\n' "$image_revision" > "$volume_root/sage-tree/image-revision"
    fi
    if [[ -z "$current" ]]; then
        mounts=(--mount type=bind,src=/home/dzack,dst=/home/dzack)
        for volume in "${volumes[@]}"; do
            mounts+=(--mount "type=volume,src=${volume%%:*},dst=${volume#*:}")
        done
        docker run -d --init --restart unless-stopped --name "$container" --entrypoint /bin/sleep \
            --env "PATH=$container_path" --env "JULIA_DEPOT_PATH=$julia_depot" \
            "${mounts[@]}" "$image" infinity
    elif [[ $(docker inspect --format '{{.State.Running}}' "$container") == false ]]; then
        docker start "$container"
    fi
    for ((attempt = 0; attempt < 120; attempt++)); do
        if docker top "$container" 2>/dev/null | grep -q 'sleep infinity'; then
            break
        fi
        if [[ $(docker inspect --format '{{.State.Running}}' "$container") != true ]]; then
            docker logs "$container"
            exit 1
        fi
        sleep 1
    done
    docker top "$container" | grep -q 'sleep infinity'
    docker exec "$container" /bin/bash -c '
        mkdir -p /root/.julia/environments
        for environment in /opt/julia-depot/environments/*; do
            target="/root/.julia/environments/${environment##*/}"
            rm -rf "$target"
            cp -a "$environment" "$target"
        done
    '
    for path in "$checkout_root"/*; do
        if [[ -L "$path" && ! -e "$path" && "$(readlink "$path")" == "$volume_root"/* ]]; then
            trash "$path"
        fi
    done
    links=("sage=$volume_root/sage-tree/_data")
    for checkout in "$volume_root"/sage-repos/_data/*/; do
        checkout=${checkout%/}
        links+=("${checkout##*/}=$checkout")
    done
    for link in "${links[@]}"; do
        path="$checkout_root/${link%%=*}"
        if [[ -e "$path" && ! -L "$path" ]]; then
            printf '%s is a separate clone of a repository the container holds; move its work into the container checkout and remove it.\n' "$path" >&2
            exit 1
        fi
        ln -sfn "${link#*=}" "$path"
    done
    docker exec -e PYTHONNOUSERSITE=1 "$container" "$sage_bin/sage" -c 'print(1)'
    exit
fi

if [[ $(docker inspect --format '{{.State.Running}}' "$container" 2>/dev/null || true) != true ]]; then
    printf 'Sage container is not running; run sage-docker-update first.\n' >&2
    exit 1
fi

env_args=(-e PYTHONNOUSERSITE=1 -e "PATH=$container_path" -e "JULIA_DEPOT_PATH=$julia_depot")
for name in PYTHONPATH MYPYPATH TMPDIR SAGE_STARTUP_FILE SAGE_CATEGORIES_GAP_PACKAGE_DIR RESEARCH_EXPERIMENTS RESEARCH_ARCHIVES RESEARCH_SOURCE; do
    if [[ -v $name ]]; then
        env_args+=(-e "$name")
    fi
done

case "$mode" in
    sage|sage-docker)
        command=("$sage_bin/sage" "$@")
        ;;
    sage-docker-preparse)
        command=("$sage_bin/sage-preparse" "$@")
        ;;
    sage-docker-python)
        if [[ ${1:-} == */sage-docker-preparse || ${1:-} == */sage-preparse ]]; then
            shift
            command=("$sage_bin/sage-preparse" "$@")
        else
            command=("$sage_bin/python" "$@")
        fi
        ;;
    julia|gap|M2|Singular|coxiter|lean|lake|elan|normaliz|polymake)
        command=("$mode" "$@")
        ;;
    *)
        printf 'Unknown Sage Docker launcher: %s\n' "$mode" >&2
        exit 2
        ;;
esac

run_id="$$-$RANDOM$RANDOM"
pid_file="/tmp/sage-docker-exec/$run_id.pid"
stop_command() {
    docker exec "$container" /bin/sh -c \
        'if [ -f "$1" ]; then
            pid=$(cat "$1"); rm -f "$1"
            if [ -d "/proc/$pid" ]; then kill -TERM "-$pid"; fi
        fi' _ "$pid_file"
}
trap 'stop_command; exit 143' TERM
trap 'stop_command; exit 130' INT
trap 'stop_command; exit 129' HUP
trap stop_command EXIT
exec 3<&0
docker exec -i -w "$PWD" "${env_args[@]}" "$container" \
    setsid -w /bin/sh -c 'mkdir -p "${1%/*}"; echo $$ > "$1"; shift; exec "$@"' _ \
    "$pid_file" "${command[@]}" <&3 &
status=0
wait $! || status=$?
exit "$status"
