#!/usr/bin/env bash
set -euo pipefail

image=ghcr.io/dzackgarza/sage:develop
container=sage-research
sage_bin=/sage/.venv/bin
container_path="$sage_bin:/opt/elan/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Docker runs rootless as this user: root in the container is this user on the
# host, so files written under /home/dzack keep their owner, and the image's own
# HOME (/root) with the Julia and Catlab environments the image build resolved
# is used as it is.
export DOCKER_HOST="unix:///run/user/$(id -u)/docker.sock"
docker() { "$HOME/bin/docker" "$@"; }

# The research checkouts live in the container: the fork at /sage (source and
# build tree) and every research repository under /repos. Each is a named
# volume that Docker fills from the image when it is created, and the host
# reaches the checkouts through ~/gitclones symlinks into the volumes, so
# agents edit, commit and push them with ordinary tools and the container runs
# what they edit.
volumes=(sage-tree:/sage sage-repos:/repos)
volume_root="$HOME/.local/share/docker/volumes"
checkout_root="$HOME/gitclones"

mode=${0##*/}
if [[ "$mode" == sage-docker-update ]]; then
    exec 9>/home/dzack/.cache/sage-docker-tmp/update.lock
    flock 9
    docker pull "$image"
    current=$(docker inspect --format '{{.Image}}' "$container" 2>/dev/null || true)
    if [[ -n "$current" && "$current" != $(docker inspect --format '{{.Id}}' "$image") ]]; then
        docker rm -f "$container"
        current=
    fi
    if [[ -z "$current" ]]; then
        mounts=(--mount type=bind,src=/home/dzack,dst=/home/dzack)
        for volume in "${volumes[@]}"; do
            mounts+=(--mount "type=volume,src=${volume%%:*},dst=${volume#*:}")
        done
        docker run -d --restart unless-stopped --name "$container" --entrypoint /bin/sleep \
            --env "PATH=$container_path" "${mounts[@]}" "$image" infinity
    elif [[ $(docker inspect --format '{{.State.Running}}' "$container") == false ]]; then
        docker start "$container"
    fi
    for ((attempt = 0; attempt < 120; attempt++)); do
        if docker top "$container" 2>/dev/null | grep -q 'sleep infinity'; then
            break
        fi
        if [[ $(docker inspect --format '{{.State.Running}}' "$container") != true ]]; then
            docker logs "$container"
            exit 1
        fi
        sleep 1
    done
    docker top "$container" | grep -q 'sleep infinity'
    links=("sage=$volume_root/sage-tree/_data")
    for checkout in "$volume_root"/sage-repos/_data/*/; do
        checkout=${checkout%/}
        links+=("${checkout##*/}=$checkout")
    done
    for link in "${links[@]}"; do
        path="$checkout_root/${link%%=*}"
        if [[ -e "$path" && ! -L "$path" ]]; then
            printf '%s is a separate clone of a repository the container holds; move its work into the container checkout and remove it.\n' "$path" >&2
            exit 1
        fi
        ln -sfn "${link#*=}" "$path"
    done
    docker exec -e PYTHONNOUSERSITE=1 "$container" "$sage_bin/sage" -c 'print(1)'
    exit
fi

if [[ $(docker inspect --format '{{.State.Running}}' "$container" 2>/dev/null || true) != true ]]; then
    printf 'Sage container is not running; run sage-docker-update first.\n' >&2
    exit 1
fi

# Julia packages resolved at runtime go to a writable depot in front of the
# image's read-only Oscar depot; the trailing empty entry keeps the stdlib depot.
env_args=(-e PYTHONNOUSERSITE=1 -e "PATH=$container_path" -e JULIA_DEPOT_PATH=/root/.julia:/opt/julia-depot:)
for name in PYTHONPATH MYPYPATH TMPDIR SAGE_STARTUP_FILE SAGE_CATEGORIES_GAP_PACKAGE_DIR RESEARCH_EXPERIMENTS RESEARCH_ARCHIVES RESEARCH_SOURCE; do
    if [[ -v $name ]]; then
        env_args+=(-e "$name")
    fi
done

case "$mode" in
    sage|sage-docker)
        command=("$sage_bin/sage" "$@")
        ;;
    sage-docker-preparse)
        command=("$sage_bin/sage-preparse" "$@")
        ;;
    sage-docker-python)
        if [[ ${1:-} == */sage-docker-preparse || ${1:-} == */sage-preparse ]]; then
            shift
            command=("$sage_bin/sage-preparse" "$@")
        else
            command=("$sage_bin/python" "$@")
        fi
        ;;
    julia|gap|M2|Singular|coxiter|lean|lake|elan|normaliz|polymake)
        command=("$mode" "$@")
        ;;
    *)
        printf 'Unknown Sage Docker launcher: %s\n' "$mode" >&2
        exit 2
        ;;
esac

exec "$HOME/bin/docker" exec -i -w "$PWD" "${env_args[@]}" \
    "$container" "${command[@]}"
