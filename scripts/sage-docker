#!/usr/bin/env bash
set -euo pipefail

image=sagemath/sagemath-dev:develop
container=sage-dev-develop

# A group change takes effect in new logins. Keep existing shells usable too.
docker_gid=$(getent group docker | cut -d: -f3)
if ! id -G | tr ' ' '\n' | grep -qx "$docker_gid"; then
    launcher_dir=$(dirname -- "$(readlink -f -- "$0")")
    exec bash "$launcher_dir/group-exec" docker env PATH="/snap/bin:$PATH" "$0" "$@"
fi

mode=${0##*/}
if [[ "$mode" == sage-docker-update ]]; then
    exec 9>/home/dzack/.cache/sage-docker-tmp/update.lock
    flock 9
    # The container holds the from-source Sage build: it is created once and never removed.
    running=$(docker inspect --format '{{.State.Running}}' "$container" 2>/dev/null || true)
    if [[ "$running" == false ]]; then
        docker start "$container"
    elif [[ -z "$running" ]]; then
        docker pull "$image"
        # Sage runs in the caller's working directory, so every repository must be visible.
        docker run -d --restart unless-stopped --name "$container" --entrypoint /bin/sleep \
            --mount type=bind,src=/home/dzack,dst=/home/dzack \
            "$image" infinity
    fi
    for ((attempt = 0; attempt < 120; attempt++)); do
        if docker top "$container" 2>/dev/null | grep -q 'sleep infinity'; then
            break
        fi
        if [[ $(docker inspect --format '{{.State.Running}}' "$container") != true ]]; then
            docker logs "$container"
            exit 1
        fi
        sleep 1
    done
    docker top "$container" | grep -q 'sleep infinity'
    docker exec -u 0 "$container" chmod o+x /home/sage
    docker exec -u 0 "$container" mkdir -p /tmp/sage-home-dzack
    docker exec -u 0 "$container" chown "$(id -u):$(id -g)" /tmp/sage-home-dzack
    if ! docker exec "$container" test -f /home/sage/sage/local/var/lib/sage/docker-py314-ready; then
        cp "$(command -v uv)" /home/dzack/.cache/sage-docker-tmp/uv
        docker exec -u 0 "$container" cp /home/dzack/.cache/sage-docker-tmp/uv /usr/local/bin/uv
        docker exec -u 0 "$container" chmod +x /usr/local/bin/uv
        docker exec "$container" uv python install 3.14
        python314=$(docker exec "$container" uv python find --managed-python --resolve-links 3.14)
        docker exec "$container" uv pip install --python "$python314" --break-system-packages setuptools
        docker exec -w /home/sage/sage "$container" ./configure --with-python="$python314"
        docker exec -w /home/sage/sage "$container" make -j2 build
        sage_python=$(docker exec "$container" sage -python -c 'import sys; print(sys.executable)')
        docker exec "$container" uv pip install --python "$sage_python" \
            'tree-sitter-sage @ git+https://github.com/dzackgarza/tree-sitter-sage@9d7901bbdb5983fa6f47c88c275904c7d6012b4a'
        docker exec "$container" touch /home/sage/sage/local/var/lib/sage/docker-py314-ready
    fi
    docker exec -u "$(id -u):$(id -g)" -e HOME=/tmp/sage-home-dzack \
        -e PYTHONNOUSERSITE=1 "$container" sage -c 'print(1)'
    exit
fi

if [[ $(docker inspect --format '{{.State.Running}}' "$container" 2>/dev/null || true) != true ]]; then
    printf 'Sage container is not running; run sage-docker-update first.\n' >&2
    exit 1
fi

env_args=(-e HOME=/tmp/sage-home-dzack -e PYTHONNOUSERSITE=1)
for name in PYTHONPATH MYPYPATH TMPDIR SAGE_STARTUP_FILE SAGE_CATEGORIES_GAP_PACKAGE_DIR SAGE_JULIA_COMMAND JULIA_COMMAND JULIAUP_DEPOT_PATH JULIA_DEPOT_PATH RESEARCH_EXPERIMENTS RESEARCH_ARCHIVES RESEARCH_SOURCE; do
    if [[ -v $name ]]; then
        env_args+=(-e "$name")
    fi
done

case "$mode" in
    sage|sage-docker)
        command=(sage "$@")
        ;;
    sage-docker-preparse)
        command=(sage -preparse "$@")
        ;;
    sage-docker-python)
        if [[ ${1:-} == */sage-docker-preparse ]]; then
            shift
            command=(sage -preparse "$@")
        elif [[ ${1:-} == */sage-preparse ]]; then
            shift
            command=(sage -preparse "$@")
        else
            command=(sage -python "$@")
        fi
        ;;
    *)
        printf 'Unknown Sage Docker launcher: %s\n' "$mode" >&2
        exit 2
        ;;
esac

exec docker exec -i -u "$(id -u):$(id -g)" -w "$PWD" "${env_args[@]}" \
    "$container" "${command[@]}"
